#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_MMI_DEVICE_DTBS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
# CONFIG_SMB1398_CHARGER is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
CONFIG_SLUB_DEBUG=y
# CONFIG_SLUB_DEBUG_ON is not set
# CONFIG_SLUB_DEBUG_PANIC_ON is not set
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y

CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
# CONFIG_CORESIGHT_LINK_AND_SINK_TMC is not set
# CONFIG_CORESIGHT_SOURCE_ETM4X is not set
# CONFIG_CORESIGHT_CTI is not set
# CONFIG_CORESIGHT_TPDA is not set
# CONFIG_CORESIGHT_TPDM is not set
# CONFIG_CORESIGHT_HWEVENT is not set
# CONFIG_CORESIGHT_DUMMY is not set
# CONFIG_CORESIGHT_REMOTE_ETM is not set
# CONFIG_CORESIGHT_TGU is not set

#
# Lineage core configs
#
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_THINLTO=y
CONFIG_LTO_CLANG=y
CONFIG_CFI_CLANG=y

#
# Wifi configs (drivers/staging/qcacld-3.0)
#
CONFIG_QCA_CLD_WLAN=m

#
# Configs for motorola-kernel-modules
#
CONFIG_INPUT_AWINIC_HAPTIC=y
# CONFIG_AW8695_HAPTIC is not set
CONFIG_MMI_SYS_TEMP=m
CONFIG_SARSENSOR_SX937X=m
# CONFIG_SX937X_USB_CAL is not set
# CONFIG_SX937X_FLIP_CAL is not set
# CONFIG_SX937X_POWER_SUPPLY_ONLINE is not set
CONFIG_MOTO_UTAGS=m
# CONFIG_TOUCHSCREEN_FTS_TS is not set
CONFIG_INPUT_TOUCHSCREEN_MMI=m
# CONFIG_TOUCHCLASS_MMI_DEBUG_INFO is not set
# CONFIG_DRM_DYNAMIC_REFRESH_RATE is not set
# CONFIG_TOUCHCLASS_MMI_GESTURE_POISON_EVENT is not set
CONFIG_DRM_PANEL_NOTIFICATIONS=y
# CONFIG_BM_ADSP_ULOG is not set
# CONFIG_USE_MMI_CHARGER is not set
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_REGULATOR_WL2864C=m
CONFIG_CAMERA_CCI_INTF=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_F_USBNET=m
CONFIG_MMI_RELAY=m
CONFIG_SENSORS_CLASS=m
# CONFIG_TZLOG_DUMP is not set
# CONFIG_WATCHDOG_CPU_CTX is not set
CONFIG_WATCHDOGTEST=m
